# Discord
BOT_TOKEN=your_bot_token_here
GUILD_ID=your_guild_id_here

# MongoDB
MONGO_URI=mongodb://localhost:27017/clash-mvp

# Clash Royale API
API_TOKEN=your_clash_royale_api_token_here

# Mercado Pago
MERCADO_PAGO_TOKEN=your_mercado_pago_token_here

# Webhook Server
WEBHOOK_PORT=3000

# Notion
NOTION_API_KEY=your_notion_api_key_here
DATABASE_ID=your_notion_database_id_here
DATABASE_DEPOSIT_ID=your_notion_deposit_database_id_here


# Discord IDs (Optional)
CHANNEL_ID=
CHANNEL_ID_QUEUE=
CHANNEL_ID_ALERTS=   # Canal #alertas-de-fila — onde o bot posta quando há fila aberta sem adversário
REGISTERED_ROLE_ID=
SUPORTE_ROLE_ID=
AVAILABLE_ROLE_ID=   # Role @Disponível — mencionada nos alertas; jogadores adicionam/removem a si mesmos

# Settings
RATE=
NODE_OPTIONS="--no-warnings --no-deprecation"
